<% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
<nav class="pagination-wrap" aria-label="Catalog pages">

  <%/* Pagination bypasses the page fade so links navigate immediately. */%>
  <% if (page > 1) { %>
    <a href="<%= baseUrl %><%= page - 1 %>" class="pg-btn" data-no-transition aria-label="Previous page">&larr;</a>
  <% } else { %>
    <span class="pg-btn disabled" aria-hidden="true">&larr;</span>
  <% } %>

  <%/* Page number buttons with ellipsis for large ranges */%>
  <%
    var delta = 2;
    var range = [];
    for (var i = Math.max(1, page - delta); i <= Math.min(totalPages, page + delta); i++) {
      range.push(i);
    }
    var showLeftDots  = range[0] > 2;
    var showRightDots = range[range.length - 1] < totalPages - 1;
  %>

  <% if (range[0] > 1) { %>
    <a href="<%= baseUrl %>1" class="pg-btn" data-no-transition aria-label="Page 1">1</a>
  <% } %>
  <% if (showLeftDots) { %><span class="pg-ellipsis" aria-hidden="true">&hellip;</span><% } %>

  <% range.forEach(function(p) { %>
    <a href="<%= baseUrl %><%= p %>" class="pg-btn<%= p === page ? ' active' : '' %>" data-no-transition aria-label="Page <%= p %>"<% if (p === page) { %> aria-current="page"<% } %>><%= p %></a>
  <% }); %>

  <% if (showRightDots) { %><span class="pg-ellipsis" aria-hidden="true">&hellip;</span><% } %>
  <% if (range[range.length - 1] < totalPages) { %>
    <a href="<%= baseUrl %><%= totalPages %>" class="pg-btn" data-no-transition aria-label="Page <%= totalPages %>"><%= totalPages %></a>
  <% } %>

  <%/* Next arrow */%>
  <% if (page < totalPages) { %>
    <a href="<%= baseUrl %><%= page + 1 %>" class="pg-btn" data-no-transition aria-label="Next page">&rarr;</a>
  <% } else { %>
    <span class="pg-btn disabled" aria-hidden="true">&rarr;</span>
  <% } %>

</nav>
<% } %>
