<% if (credit && credit.commons) { %>
  <% const source = credit.url && !credit.name ? credit.url : 'https://commons.wikimedia.org/'; %>
  Photo<% if (credit.name) { %>: <% if (credit.url) { %><a href="<%= credit.url %>" target="_blank" rel="noopener"><%= credit.name %></a><% } else { %><%= credit.name %><% } %>,<% } %>
  via <a href="<%= source %>" target="_blank" rel="noopener">Wikimedia Commons</a><% if (credit.license) { %>, <% if (credit.licenseUrl) { %><a href="<%= credit.licenseUrl %>" target="_blank" rel="noopener license"><%= credit.license %></a><% } else { %><%= credit.license %><% } %><% } %>
<% } else if (credit) { %>
  Photo<% if (credit.name) { %>: <% if (credit.url) { %><a href="<%= credit.url %>" target="_blank" rel="noopener"><%= credit.name %></a><% } else { %><%= credit.name %><% } %><% } else if (credit.url) { %> from <a href="<%= credit.url %>" target="_blank" rel="noopener">original source</a><% } %><% if (credit.license) { %> · <% if (credit.licenseUrl) { %><a href="<%= credit.licenseUrl %>" target="_blank" rel="noopener license"><%= credit.license %></a><% } else { %><%= credit.license %><% } %><% } %>
<% } %>
