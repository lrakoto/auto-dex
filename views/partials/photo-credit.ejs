<% if (credit && credit.commons) { %><% const source = credit.url && !credit.name ? credit.url : 'https://commons.wikimedia.org/'; %>Photo<% if (credit.name) { %>: <% if (credit.url) { %><a href="<%= credit.url %>" target="_blank" rel="noopener"><%= credit.name %></a><% } else { %><%= credit.name %><% } %>,<% } %> via <a href="<%= source %>" target="_blank" rel="noopener">Wikimedia Commons</a><% if (credit.license) { %>, <% if (credit.licenseUrl) { %><a href="<%= credit.licenseUrl %>" target="_blank" rel="noopener license"><%= credit.license %></a><% } else { %><%= credit.license %><% } %><% } %><% } else if (credit) { %><% if (credit.name) { %>Photo: <% if (credit.url) { %><a href="<%= credit.url %>" target="_blank" rel="noopener"><%= credit.name %></a><% } else { %><%= credit.name %><% } %><% if (credit.unsplash) { %> on <a href="https://unsplash.com/?utm_source=autodex&amp;utm_medium=referral" target="_blank" rel="noopener">Unsplash</a><% } %><% } else if (credit.unsplash) { %>Photo from <a href="https://unsplash.com/?utm_source=autodex&amp;utm_medium=referral" target="_blank" rel="noopener">Unsplash</a><% } %><% } %>
