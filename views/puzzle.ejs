<%
  const tileResults = {
    exact: { symbol: '✓', label: 'Match' },
    close: { symbol: '≈', label: 'Close' },
    wrong: { symbol: '×', label: 'Different' },
    unknown: { symbol: '?', label: 'Not enough data' }
  };
  const decadeDirections = {
    higher: { symbol: '↑', label: 'Guess a later decade' },
    lower: { symbol: '↓', label: 'Guess an earlier decade' }
  };
%>
<section class="jumbotron text-center">
  <div class="container">
    <p class="eyebrow">Daily Puzzle</p>
    <h1 class="jumbotron-heading">Guess the Mystery Car</h1>
    <p class="lead text-muted">Everyone gets the same car and six guesses. Clues cover make, country, decade, class, drivetrain and fuel.</p>
  </div>
</section>

<div class="container py-5">
  <div class="puzzle-layout">
    <div class="puzzle-main">
      <% if (typeof accountStatsPending !== 'undefined' && accountStatsPending) { %>
        <p id="puzzle-account-save-notice" class="puzzle-note puzzle-save-notice" role="status">Reload to retry saving your results to your account.</p>
      <% } %>
      <% if (!answer) { %>
        <div class="empty-state">
          <div class="empty-icon">?</div>
          <h3>Not enough dated cars yet</h3>
          <p>The puzzle needs catalog cars with known production years. They're added every day, so check back soon.</p>
          <a href="/cars/explore" class="btn btn-outline-secondary mt-3">Explore cars</a>
        </div>
      <% } else { %>
        <div class="puzzle-card">
          <div class="puzzle-stats" aria-live="polite">
            <span class="puzzle-stat">Guess <strong><%= guesses.length + (done ? 0 : 1) %></strong> of <%= maxGuesses %></span>
            <span class="puzzle-stat" data-puzzle-streak data-day="<%= puzzleDay %>" data-result="<%= done ? (won ? 'won' : 'lost') : 'pending' %>" title="Consecutive wins. The puzzle resets at midnight UTC." hidden>Win streak <strong data-puzzle-streak-count>0</strong> <span>· this browser</span></span>
          </div>

          <% if (error) { %>
            <p class="puzzle-error" role="alert"><%= error %></p>
          <% } %>

          <% if (guesses.length) { %>
            <div class="puzzle-board-scroll" role="region" aria-label="Guess board" tabindex="0">
              <table class="puzzle-board" aria-label="Your guesses so far">
                <thead>
                  <tr>
                    <th scope="col">Guess</th>
                    <th scope="col">Make</th>
                    <th scope="col">Country</th>
                    <th scope="col">Decade</th>
                    <th scope="col">Class</th>
                    <th scope="col">Drive</th>
                    <th scope="col">Fuel</th>
                  </tr>
                </thead>
                <tbody>
                  <% guesses.forEach(g => {
                    const tiles = [
                      [g.make, g.makeState],
                      [g.country, g.countryState],
                      [g.decade + 's', g.decadeState, decadeDirections[g.decadeDirection]],
                      [g.bodyClass, g.bodyClassState],
                      [g.drive, g.driveState],
                      [g.fuel, g.fuelState]
                    ];
                  %>
                    <tr class="<%= g.correct ? 'is-correct-row' : '' %>">
                      <th scope="row" class="puzzle-guess-name"><%= g.make %> <%= g.model %></th>
                      <% tiles.forEach(([value, comparison, direction]) => {
                        const state = comparison || 'unknown';
                        const result = tileResults[state];
                      %>
                        <td><span class="puzzle-tile puzzle-tile--<%= state %>"><%= value || 'Unknown' %>
                          <span class="puzzle-result-symbol" aria-hidden="true"><%= result.symbol %></span>
                          <% if (direction) { %><span class="puzzle-arrow" aria-hidden="true"><%= direction.symbol %></span><% } %>
                          <span class="sr-only"> · <%= result.label %><% if (direction) { %>. <%= direction.label %><% } %></span>
                        </span></td>
                      <% }) %>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>

          <% if (done) { %>
            <div class="puzzle-result">
              <p class="puzzle-verdict <%= won ? 'is-correct' : 'is-wrong' %>" role="status">
                <% if (won) { %>Got it in <%= guesses.length %><% } else { %>Out of guesses<% } %> —
                it was the <a href="<%= answerUrl %>"><%= answer.make %> <%= answer.model %></a>.
              </p>
              <% if (shareText) { %>
                <div class="puzzle-share">
                  <label for="puzzle-share-text" class="field-label">Spoiler-free result</label>
                  <textarea id="puzzle-share-text" class="puzzle-input puzzle-share-text" rows="<%= shareText.split('\n').length %>" readonly><%= shareText %></textarea>
                  <div class="puzzle-share-actions">
                    <button type="button" id="puzzle-share-copy" class="btn btn-outline-secondary btn-sm" hidden>Copy result</button>
                    <span id="puzzle-share-status" role="status"></span>
                  </div>
                </div>
              <% } %>
              <p class="puzzle-note">A new car is up at midnight UTC.</p>
            </div>
          <% } else { %>
            <form method="POST" action="/puzzle/guess" id="puzzle-form" class="puzzle-form" autocomplete="off">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="day" value="<%= puzzleDay %>">
              <label for="puzzle-guess" class="sr-only">Guess a car</label>
              <input type="text" name="guess" id="puzzle-guess" class="puzzle-input" list="puzzle-suggestions" placeholder="Make and model, e.g. Honda Civic" required>
              <datalist id="puzzle-suggestions"></datalist>
              <button type="submit" class="btn btn-primary">Guess</button>
            </form>
            <p class="puzzle-hint"><%= guessesLeft %> guess<%= guessesLeft === 1 ? '' : 'es' %> left.</p>
          <% } %>
        </div>
      <% } %>
    </div>

    <aside class="puzzle-side">
      <div class="media-card">
        <h2 class="puzzle-legend-heading" id="puzzle-legend-heading">How to read a tile</h2>
        <ul class="puzzle-legend" aria-labelledby="puzzle-legend-heading" role="list">
          <% Object.entries(tileResults).forEach(([state, result]) => { %>
            <li><span class="puzzle-tile puzzle-tile--<%= state %>"><span class="puzzle-result-symbol" aria-hidden="true"><%= result.symbol %></span> <%= result.label %></span></li>
          <% }) %>
        </ul>
        <p class="puzzle-note">Close means one decade away. Arrows point to a later <span aria-hidden="true">(↑)</span> or earlier <span aria-hidden="true">(↓)</span> decade.</p>
      </div>
      <% if (typeof accountStats !== 'undefined' && accountStats) { %>
        <section id="puzzle-account-stats" class="media-card puzzle-account-stats" aria-labelledby="puzzle-account-stats-heading">
          <h2 id="puzzle-account-stats-heading">Your puzzle stats</h2>
          <dl class="puzzle-account-summary">
            <div>
              <dt>Games played</dt>
              <dd id="puzzle-games-played"><%= accountStats.gamesPlayed %></dd>
            </div>
            <div>
              <dt>Win rate</dt>
              <dd id="puzzle-win-rate"><%= accountStats.winRate %>%</dd>
            </div>
          </dl>
          <% if (accountStats.gamesPlayed) { %>
            <table id="puzzle-guess-distribution">
              <caption>Wins by number of guesses</caption>
              <thead>
                <tr>
                  <% accountStats.guessDistribution.forEach((_, index) => { %>
                    <th scope="col"><%= index + 1 %><span class="sr-only"> <%= index === 0 ? 'guess' : 'guesses' %></span></th>
                  <% }) %>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <% accountStats.guessDistribution.forEach((wins, index) => { %>
                    <td data-guess-count="<%= index + 1 %>"><%= wins %></td>
                  <% }) %>
                </tr>
              </tbody>
            </table>
          <% } else { %>
            <p id="puzzle-stats-empty">Play a puzzle from start to finish while signed in to start tracking your results.</p>
          <% } %>
        </section>
      <% } %>
    </aside>
  </div>
</div>

<script src="/js/puzzle.js" defer></script>
<script src="/js/puzzle-streak.js" defer></script>
