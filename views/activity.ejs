<section class="jumbotron text-center">
  <div class="container">
    <h1 class="jumbotron-heading" id="activity-heading">Recent sightings</h1>
    <p class="lead text-muted">See what AutoDex members have spotted and shared in their public garages.</p>
  </div>
</section>

<div class="container pb-5 activity">
  <% const records = typeof quizRecords !== 'undefined' ? quizRecords : []; %>
  <% if (candidates.length || unavailableVoteToken) { %>
    <section id="spot-of-the-day" class="activity-contest" aria-labelledby="activity-contest-heading">
      <h2 id="activity-contest-heading">Spot of the Day</h2>
      <% if (unavailableVoteToken) { %>
        <p class="activity-contest-note">Your vote is for a photo that’s currently unavailable.</p>
        <form method="POST" action="/activity/vote" class="activity-vote-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="day" value="<%= voteDay %>">
          <input type="hidden" name="withdrawalToken" value="<%= unavailableVoteToken %>">
          <button type="submit" name="action" value="withdraw-unavailable" class="btn btn-outline-secondary btn-sm activity-vote">Withdraw your vote</button>
        </form>
      <% } %>
      <% if (candidates.length) { %>
        <p class="activity-contest-note">Choose one photo per day. Voting resets at midnight UTC.</p>
        <% if (!currentUser) { %>
          <a class="btn btn-outline-secondary btn-sm activity-vote" href="/auth/login?returnTo=%2Factivity%23spot-of-the-day">Log in to vote</a>
        <% } %>
        <ul class="activity-candidates" role="list">
          <% candidates.forEach(candidate => { %>
            <% const vehicle = candidate.make + ' ' + candidate.model; %>
            <li class="activity-candidate">
              <img class="activity-candidate-photo" src="<%= candidate.imageUrl %>" alt="<%= vehicle %> sighting" width="128" height="96" loading="lazy" decoding="async" referrerpolicy="no-referrer">
              <div class="activity-details">
                <h3><a href="<%= candidate.carUrl %>"><%= vehicle %></a></h3>
                <a class="activity-garage" href="<%= candidate.garageUrl %>"><%= candidate.garageName %></a>
                <p class="activity-candidate-count">
                  <%= candidate.votes %> <%= candidate.votes === 1 ? 'vote' : 'votes' %>
                  <% if (candidate.isLeading) { %>
                    · <strong><%= hasTiedLeaders ? 'Tied for the lead' : 'Leading today' %></strong>
                  <% } %>
                </p>
                <% if (currentUser && !candidate.canVote && !candidate.isMine) { %>
                  <p class="activity-candidate-count">Your sighting</p>
                <% } %>
              </div>
              <% if (currentUser && (candidate.canVote || candidate.isMine)) { %>
                <% const label = candidate.isMine ? 'Withdraw vote' : hasVote ? 'Move vote' : 'Vote'; %>
                <form method="POST" action="/activity/vote" class="activity-vote-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="spottingId" value="<%= candidate.id %>">
                  <input type="hidden" name="day" value="<%= voteDay %>">
                  <button type="submit" name="action" value="<%= candidate.isMine ? 'withdraw' : 'vote' %>" class="btn btn-outline-secondary btn-sm activity-vote" aria-label="<%= label %> for <%= vehicle %>"><%= label %></button>
                </form>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  <% } %>
  <% if (spots.length) { %>
    <ol id="activity-feed" class="activity-feed" role="list" aria-labelledby="activity-heading">
      <% spots.forEach(spot => { %>
        <li class="activity-sighting">
          <div class="activity-details">
            <h2><a href="<%= spot.carUrl %>"><%= spot.make %> <%= spot.model %></a></h2>
            <a class="activity-garage" href="<%= spot.garageUrl %>"><%= spot.garageName %></a>
            <% if (spot.firstSpot) { %>
              <span class="activity-first-spot" title="First sighting still in this garage">
                <span aria-hidden="true"><%= firstSpotBadge.icon %></span> <%= firstSpotBadge.name %>
                <span class="sr-only"> badge. First sighting still in this garage.</span>
              </span>
            <% } %>
          </div>
          <time datetime="<%= spot.dateIso %>"><%= spot.dateLabel %></time>
        </li>
      <% }) %>
    </ol>
  <% } else if (records.length) { %>
    <p id="activity-sightings-empty" class="activity-sightings-empty">No public sightings yet.</p>
  <% } else { %>
    <div id="activity-empty" class="empty-state empty-state--results">
      <h2>No public sightings yet</h2>
      <p>Recent spots will appear here when members share them in their public garages.</p>
      <a class="btn btn-outline-secondary mt-3" href="/cars/explore">Explore cars</a>
    </div>
  <% } %>
  <% if (records.length) { %>
    <section id="quiz-records" class="activity-quiz" aria-labelledby="quiz-records-heading">
      <div class="activity-quiz-heading">
        <div>
          <h2 id="quiz-records-heading">Recent quiz records</h2>
          <p>Personal best streaks in the car photo quiz. Dates show when each best was set.</p>
        </div>
        <a class="btn btn-outline-secondary btn-sm activity-quiz-play" href="/play">Play the car quiz</a>
      </div>
      <ol class="activity-feed" role="list" aria-labelledby="quiz-records-heading">
        <% records.forEach(record => { %>
          <li class="activity-quiz-record">
            <div class="activity-details">
              <a class="activity-garage" href="<%= record.garageUrl %>"><%= record.garageName %></a>
              <p class="activity-quiz-score">
                <strong><%= record.best %> in a row</strong>
                <% if (record.carWhisperer) { %>
                  <span class="activity-quiz-badge" title="Current quiz badge">
                    <span aria-hidden="true"><%= carWhispererBadge.icon %></span> <%= carWhispererBadge.name %>
                    <span class="sr-only"> badge</span>
                  </span>
                <% } %>
              </p>
            </div>
            <time datetime="<%= record.dateIso %>"><%= record.dateLabel %></time>
          </li>
        <% }) %>
      </ol>
    </section>
  <% } %>
</div>
