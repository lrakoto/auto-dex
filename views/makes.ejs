<section class="jumbotron text-center">
  <div class="container">
    <h1 class="jumbotron-heading">Browse Manufacturers</h1>
    <% var makers = (n, kind) => n + ' ' + kind + ' maker' + (n === 1 ? '' : 's'); %>
    <p class="lead text-muted">
      <%= makers(shelves[0].makes.length, 'car') %> · <%= makers(shelves[1].makes.length, 'motorcycle') %><% if (shelves[2].makes.length) { %> · <%= makers(shelves[2].makes.length, 'truck, bus and trailer') %><% } %>
    </p>
    <nav class="type-tabs" aria-label="Manufacturer shelves">
      <% shelves.filter(s => s.makes.length).forEach(s => { %>
        <a class="type-tab" href="#<%= s.id %>"><%= s.title %> <span class="type-count"><%= s.makes.length %></span></a>
      <% }) %>
    </nav>
  </div>
</section>

<% shelves.filter(s => s.makes.length).forEach(function(shelf) { %>
<div class="makes-container" id="<%= shelf.id %>">
  <h2 class="makes-shelf-title"><%= shelf.title %></h2>
  <div class="makes-grid">
    <%
    const withLogo = shelf.makes.filter(m => domainMap[m.make]);
    const withoutLogo = shelf.makes.filter(m => !domainMap[m.make]);
    [...withLogo, ...withoutLogo].forEach(function(m) {
      const domain = domainMap[m.make] || null;
      const initials = m.make.split(/[\s\-]/).map(w => w[0]).join('').slice(0, 2).toUpperCase();
    %>
      <div class="make-tile-wrap">
        <a href="<%= m.href %>" class="make-tile">
          <div class="make-logo-wrap">
            <span class="make-logo-initials"><%= initials %></span>
            <% if (domain) { %>
              <img
                class="make-logo"
                src="https://www.google.com/s2/favicons?domain=<%= domain %>&sz=64"
                alt="<%= m.make %>"
                width="32"
                height="32"
                loading="lazy"
                referrerpolicy="no-referrer"
                data-onerror-hide
              >
            <% } %>
          </div>
          <span class="make-name"><%= m.make %></span>
          <span class="make-count"><%= m.label %></span>
        </a>
      </div>
    <% }); %>
  </div>
</div>
<% }); %>
