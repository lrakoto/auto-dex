<div class="car-hero" style="background-image: url('<%= car.image %>');">
  <div class="car-hero-overlay">
    <div class="car-hero-text">
      <h1><%= car.make %> <span><%= car.model %></span></h1>
      <p class="car-hero-sub"><%= car.year %><% if (car.vin) { %> · VIN <%= car.vin %><% } %></p>
    </div>
  </div>
</div>

<div class="detail-container">
  <div class="detail-actions d-flex justify-content-between align-items-center flex-wrap" style="gap:1rem;">
    <a href="/garage" class="btn btn-outline-secondary btn-sm">&larr; My Garage</a>
    <a href="/cars/car?make=<%= encodeURIComponent(car.make) %>&model=<%= encodeURIComponent(car.model) %>" class="btn btn-outline-secondary btn-sm">View <%= car.model %> in catalog</a>
  </div>
</div>

<div class="detail-container py-5">
  <% if (car.notes) { %>
    <p class="lead" style="color:#a1a1aa;"><%= car.notes %></p>
  <% } %>

  <!-- Recalls -->
  <section id="recalls" class="garage-section">
    <div class="accent-line"></div>
    <h2 class="garage-h2">Safety Recalls</h2>
    <% if (recalls === null) { %>
      <p class="text-muted">We couldn't reach NHTSA just now. Try again in a bit.</p>
    <% } else if (recalls.length === 0) { %>
      <p class="recall-clear">✓ No recalls on file with NHTSA for the <%= car.year %> <%= car.make %> <%= car.model %>.</p>
    <% } else { %>
      <p class="text-muted">
        NHTSA lists <strong class="recall-count"><%= recalls.length %> recall<%= recalls.length === 1 ? '' : 's' %></strong>
        for the <%= car.year %> <%= car.make %> <%= car.model %>. Not every recall covers every car. Check yours
        <% if (car.vin) { %>
          at <a href="https://www.nhtsa.gov/recalls?vin=<%= encodeURIComponent(car.vin) %>" target="_blank" rel="noopener">nhtsa.gov/recalls</a> with your VIN.
        <% } else { %>
          by VIN at <a href="https://www.nhtsa.gov/recalls" target="_blank" rel="noopener">nhtsa.gov/recalls</a>.
        <% } %>
      </p>
      <div class="recall-list">
        <% recalls.forEach(r => { %>
          <details class="recall-item<%= r.parkIt ? ' recall-parkit' : '' %>">
            <summary>
              <span class="recall-component"><%= r.component %></span>
              <span class="recall-meta"><%= r.date %> · #<%= r.campaign %></span>
              <% if (r.parkIt) { %><span class="recall-flag">Do not drive</span><% } %>
            </summary>
            <p><%= r.summary %></p>
            <% if (r.consequence) { %><p><strong>Risk:</strong> <%= r.consequence %></p><% } %>
            <% if (r.remedy) { %><p><strong>Remedy:</strong> <%= r.remedy %></p><% } %>
          </details>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- Maintenance -->
  <section id="maintenance" class="garage-section">
    <div class="accent-line"></div>
    <h2 class="garage-h2">Maintenance Log</h2>
    <% if (logs.length > 0) { %>
      <p class="text-muted"><%= logs.length %> entr<%= logs.length === 1 ? 'y' : 'ies' %><% if (totalCost > 0) { %> · $<%= totalCost.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> total<% } %></p>
      <div class="maint-wrap">
        <table class="maint-table">
          <thead>
            <tr><th scope="col">Date</th><th scope="col">Work</th><th scope="col">Mileage</th><th scope="col">Cost</th><th scope="col"><span class="sr-only">Actions</span></th></tr>
          </thead>
          <tbody>
            <% logs.forEach(l => { %>
              <tr>
                <td class="nowrap"><%= l.date %></td>
                <td>
                  <%= l.title %>
                  <% if (l.notes) { %><div class="maint-notes"><%= l.notes %></div><% } %>
                </td>
                <td class="nowrap"><%= l.mileage != null ? Number(l.mileage).toLocaleString('en-US') + ' mi' : '—' %></td>
                <td class="nowrap"><%= l.cost != null ? '$' + Number(l.cost).toFixed(2) : '—' %></td>
                <td>
                  <form method="POST" action="/garage/car/<%= car.id %>/maintenance/<%= l.id %>?_method=DELETE" style="margin:0;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="vote-btn" aria-label="Delete entry" title="Delete entry">✕</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-muted">Nothing logged yet. Oil changes, tires, mods: add them below.</p>
    <% } %>

    <form method="POST" action="/garage/car/<%= car.id %>/maintenance" class="maint-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-row">
        <div class="form-group col-md-3">
          <label class="field-label" for="mDate">Date</label>
          <input type="date" class="form-control" id="mDate" name="date" value="<%= today %>" required>
        </div>
        <div class="form-group col-md-5">
          <label class="field-label" for="mTitle">Work done</label>
          <input type="text" class="form-control" id="mTitle" name="title" maxlength="120" placeholder="e.g. Oil change + filter" required>
        </div>
        <div class="form-group col-md-2">
          <label class="field-label" for="mMileage">Mileage</label>
          <input type="number" class="form-control" id="mMileage" name="mileage" min="0" step="1" placeholder="42000">
        </div>
        <div class="form-group col-md-2">
          <label class="field-label" for="mCost">Cost ($)</label>
          <input type="number" class="form-control" id="mCost" name="cost" min="0" step="0.01" placeholder="59.99">
        </div>
      </div>
      <div class="form-group">
        <label class="field-label" for="mNotes">Notes</label>
        <input type="text" class="form-control" id="mNotes" name="notes" maxlength="2000" placeholder="Optional">
      </div>
      <button type="submit" class="btn btn-primary btn-sm">Add Entry</button>
    </form>
  </section>
</div>
