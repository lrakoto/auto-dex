<section class="jumbotron text-center">
  <div class="container">
    <h1 class="jumbotron-heading">My Garage</h1>
    <p class="lead text-muted"><%= currentUser.name %>'s cars and favorites</p>
    <a href="/garage/add" class="btn btn-primary">+ Add My Car</a>
    <% if (currentUser.isAdmin) { %>
      <a href="/garage/admin" class="btn btn-warning ml-2">Admin: Manage Images</a>
    <% } %>
    <nav class="garage-subnav" aria-label="Garage sections">
      <a href="#my-cars">My Cars</a>
      <a href="#dex">Dex <span class="subnav-count"><%= dex.spottedCars %></span></a>
      <a href="#favorites">Favorites</a>
      <a href="#settings">Settings</a>
      <% if (currentUser.garagePublic && currentUser.username) { %>
        <a href="/u/<%= currentUser.username %>">Public page ↗</a>
      <% } %>
    </nav>
  </div>
</section>

<div class="container pb-5">

  <h2 class="text-left mb-3" id="my-cars">My Cars</h2>
  <% if (myCars.length === 0) { %>
    <p class="text-muted">You haven't added any cars yet. <a href="/garage/add">Add one now!</a></p>
  <% } else { %>
    <div class="row">
      <% myCars.forEach(car => { %>
        <div class="col-md-4 mb-4 card-col">
          <div class="card box-shadow">
            <span class="card-badge card-badge--garage">My Car</span>
            <a class="recall-badge" href="/garage/car/<%= car.id %>#recalls" data-recalls-url="/garage/car/<%= car.id %>/recalls" hidden></a>
            <a href="/garage/car/<%= car.id %>">
              <img class="card-img-top imgresp" src="<%= car.image %>" alt="<%= car.year %> <%= car.make %> <%= car.model %>">
            </a>
            <div class="card-body text-left">
              <h5 class="card-title"><a href="/garage/car/<%= car.id %>" class="text-dark"><%= car.year %> <%= car.make %> <%= car.model %></a></h5>
              <% if (car.notes) { %>
                <p class="card-text text-muted"><%= car.notes %></p>
              <% } %>
              <div class="d-flex" style="gap:0.5rem;">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-toggle="modal" data-target="#editCarModal<%= car.id %>">Edit</button>
                <form method="POST" action="/garage/car/<%= car.id %>?_method=DELETE" style="margin:0;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                </form>
              </div>
            </div>
          </div>
        </div>

        <!-- Edit Modal -->
        <div class="modal fade" id="editCarModal<%= car.id %>" tabindex="-1" role="dialog" aria-modal="true" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title"><%= car.year %> <%= car.make %> <%= car.model %></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                  <span aria-hidden="true">&times;</span>
                </button>
              </div>
              <div class="modal-body">
                <div class="img-source-tabs" role="tablist" aria-label="Image source">
                  <button type="button" role="tab" id="car-url-<%= car.id %>-tab" class="img-tab-btn active" data-tab="car-url-<%= car.id %>" aria-controls="car-url-<%= car.id %>" aria-selected="true">Use URL</button>
                  <button type="button" role="tab" id="car-upload-<%= car.id %>-tab" class="img-tab-btn" data-tab="car-upload-<%= car.id %>" aria-controls="car-upload-<%= car.id %>" aria-selected="false" tabindex="-1">Upload File</button>
                </div>

                <div id="car-url-<%= car.id %>" class="img-tab-pane" role="tabpanel" aria-labelledby="car-url-<%= car.id %>-tab">
                  <form id="car-url-form-<%= car.id %>" method="POST" action="/garage/car/<%= car.id %>?_method=PUT">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="carid" value="<%= car.id %>">
                    <input type="text" class="form-control mb-2" name="imageUrl" placeholder="https://…" autocomplete="off">
                    <input type="text" class="form-control" name="notes" placeholder="Notes (optional)" value="<%= car.notes || '' %>">
                  </form>
                </div>

                <div id="car-upload-<%= car.id %>" class="img-tab-pane" role="tabpanel" aria-labelledby="car-upload-<%= car.id %>-tab" style="display:none;">
                  <form id="car-upload-form-<%= car.id %>" method="POST" action="/garage/car/<%= car.id %>?_method=PUT&_csrf=<%= csrfToken %>" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="carid" value="<%= car.id %>">
                    <input type="file" class="form-control-file mb-2" name="carImage" accept="image/*">
                    <input type="text" class="form-control" name="notes" placeholder="Notes (optional)" value="<%= car.notes || '' %>">
                  </form>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-primary garage-update-btn" data-id="<%= car.id %>">Save Changes</button>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <hr class="my-5">

  <h2 class="text-left mb-3" id="dex">My Dex</h2>
  <% if (dex.spottedCars === 0) { %>
    <p class="text-muted">You haven't spotted anything yet. Open any car and hit <strong>👀 Spotted it</strong> when you see one in the wild.</p>
  <% } else { %>
    <p class="text-muted"><%= dex.spottedCars %> car<%= dex.spottedCars === 1 ? '' : 's' %> spotted across <%= dex.spottedMakes %> make<%= dex.spottedMakes === 1 ? '' : 's' %>.</p>
    <div class="dex-makes">
      <% dex.makes.forEach(m => { %>
        <a class="dex-make" href="/cars?selectmake=<%= encodeURIComponent(m.make) %>">
          <span class="dex-make-name"><%= m.make %></span>
          <span class="dex-bar"><span style="width:<%= m.pct %>%"></span></span>
          <span class="dex-progress-count"><%= m.spotted %>/<%= m.total %></span>
        </a>
      <% }) %>
    </div>
  <% } %>

  <h3 class="garage-h3">Badges</h3>
  <div class="badge-grid">
    <% badges.forEach(b => { %>
      <div class="badge-tile<%= b.earned ? ' earned' : '' %>" title="<%= b.desc %>">
        <span class="badge-icon" aria-hidden="true"><%= b.icon %></span>
        <span class="badge-name"><%= b.name %></span>
        <span class="badge-desc"><%= b.earned ? 'Earned' : b.desc %></span>
      </div>
    <% }) %>
  </div>

  <% if (recentSpots.length > 0) { %>
    <h3 class="garage-h3">Recent Spots</h3>
    <div class="row">
      <% recentSpots.forEach(sp => { %>
        <div class="col-md-3 col-6 mb-4 card-col">
          <div class="card h-100">
            <a href="/cars/car?make=<%= encodeURIComponent(sp.car.make) %>&model=<%= encodeURIComponent(sp.car.model) %>">
              <img class="card-img-top imgresp spot-img" src="<%= sp.imageUrl || sp.car.image %>" alt="<%= sp.car.make %> <%= sp.car.model %>">
            </a>
            <div class="card-body text-left">
              <p class="card-text mb-1"><strong><%= sp.car.make %> <%= sp.car.model %></strong></p>
              <p class="spot-meta"><%= new Date(sp.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %><% if (sp.location) { %> · <%= sp.location %><% } %></p>
              <form method="POST" action="/garage/spot/<%= sp.id %>?_method=DELETE" style="margin:0;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <hr class="my-5">

  <h2 class="text-left mb-3" id="favorites">Favorite Cars</h2>
  <% if (favorites.length === 0) { %>
    <p class="text-muted">No favorites yet. <a href="/">Search for cars</a> to add some!</p>
  <% } else { %>
    <div class="row">
      <% favorites.forEach(f => { %>
        <div class="col-md-4 mb-4 card-col">
          <div class="card box-shadow">
            <span class="card-badge card-badge--favorite">&#9825; Favorite</span>
            <a href="/cars/car?make=<%= encodeURIComponent(f.make) %>&model=<%= encodeURIComponent(f.model) %>&image=<%= encodeURIComponent(f.image) %>">
              <img class="card-img-top imgresp" src="<%= f.image %>" alt="<%= f.make %> <%= f.model %>">
            </a>
            <div class="card-body text-left">
              <p class="card-text mb-2"><strong><%= f.make %> <%= f.model %></strong></p>
              <div class="d-flex" style="gap:0.5rem;">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-toggle="modal" data-target="#editFavModal<%= f.id %>">Edit</button>
                <form method="POST" action="/cars/favorites/delete/<%= f.id %>?_method=DELETE" style="margin:0;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                </form>
              </div>
            </div>
          </div>
        </div>

        <!-- Edit Favorite Modal -->
        <div class="modal fade" id="editFavModal<%= f.id %>" tabindex="-1" role="dialog" aria-modal="true" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title"><%= f.make %> <%= f.model %></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                  <span aria-hidden="true">&times;</span>
                </button>
              </div>
              <div class="modal-body">
                <div class="img-source-tabs" role="tablist" aria-label="Image source">
                  <button type="button" role="tab" id="fav-url-<%= f.id %>-tab" class="img-tab-btn active" data-tab="fav-url-<%= f.id %>" aria-controls="fav-url-<%= f.id %>" aria-selected="true">Use URL</button>
                  <button type="button" role="tab" id="fav-upload-<%= f.id %>-tab" class="img-tab-btn" data-tab="fav-upload-<%= f.id %>" aria-controls="fav-upload-<%= f.id %>" aria-selected="false" tabindex="-1">Upload File</button>
                </div>
                <div id="fav-url-<%= f.id %>" class="img-tab-pane" role="tabpanel" aria-labelledby="fav-url-<%= f.id %>-tab">
                  <form id="fav-url-form-<%= f.id %>" method="POST" action="/cars/favorites/edit/<%= f.id %>?_method=PUT">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="favid" value="<%= f.id %>">
                    <input type="text" class="form-control" name="newimagelink" placeholder="https://…" autocomplete="off">
                  </form>
                </div>
                <div id="fav-upload-<%= f.id %>" class="img-tab-pane" role="tabpanel" aria-labelledby="fav-upload-<%= f.id %>-tab" style="display:none;">
                  <form id="fav-upload-form-<%= f.id %>" method="POST" action="/cars/favorites/edit/<%= f.id %>?_method=PUT&_csrf=<%= csrfToken %>" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="favid" value="<%= f.id %>">
                    <input type="file" class="form-control-file" name="newimage" accept="image/*">
                  </form>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-primary fav-update-btn" data-id="<%= f.id %>">Update Image</button>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <hr class="my-5">

  <h2 class="text-left mb-3" id="settings">Settings</h2>
  <form method="POST" action="/garage/settings" class="settings-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group">
      <label for="username" class="field-label">Username</label>
      <div class="input-prefix">
        <span><%= siteUrl.replace(/^https?:\/\//, '') %>/u/</span>
        <input type="text" class="form-control" id="username" name="username" value="<%= currentUser.username || '' %>"
               maxlength="30" pattern="[A-Za-z0-9_]{3,30}" placeholder="your_handle" autocomplete="off">
      </div>
      <small class="text-muted">3–30 letters, numbers or underscores.</small>
    </div>
    <div class="form-check mb-3">
      <input type="checkbox" class="form-check-input" id="garagePublic" name="garagePublic" <%= currentUser.garagePublic ? 'checked' : '' %>>
      <label class="form-check-label" for="garagePublic">Make my garage public</label>
      <small class="d-block text-muted">Shows your cars, favorites, Dex and badges. Never your email, VINs or notes.</small>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Save Settings</button>
  </form>
</div>
