<section class="jumbotron text-center">
  <div class="container">
    <h1 class="jumbotron-heading">Find vehicle photos</h1>
    <p class="lead">Choose an accurate replacement from Wikimedia Commons or Openverse.</p>
    <a href="/garage/admin">← Admin</a>
  </div>
</section>

<div class="container pb-5 photo-review">
  <form action="/garage/admin/photos" method="GET" class="photo-review-search mb-4">
    <div class="form-group mb-0">
      <label for="photo-vehicle-search">Find a vehicle</label>
      <input id="photo-vehicle-search" name="q" class="form-control" value="<%= q %>" placeholder="Make or model" maxlength="100" required>
    </div>
    <button class="btn btn-primary" type="submit">Search vehicles</button>
  </form>

  <% if (q) { %>
    <section aria-labelledby="photo-results-heading" class="mb-5">
      <h2 id="photo-results-heading" class="h4">Vehicles matching “<%= q %>”</h2>
      <p><%= totalCars.toLocaleString() %> result<%= totalCars === 1 ? '' : 's' %></p>
      <div class="photo-review-results">
        <% cars.forEach(car => { %>
          <a class="photo-review-result" href="/garage/admin/photos?carId=<%= car.id %>&q=<%= encodeURIComponent(q) %>">
            <img src="<%= cardPhoto(car.image) %>" alt="" loading="lazy">
            <span><strong><%= car.make %> <%= car.model %></strong><% if (car.vehicle_type) { %><small><%= car.vehicle_type %></small><% } %></span>
          </a>
        <% }) %>
      </div>
      <% if (!cars.length) { %><p>No matching vehicles. Try a make or a shorter model name.</p><% } %>
      <% if (totalPages > 1) { %>
        <nav aria-label="Vehicle search pages" class="d-flex align-items-center mt-3" style="gap:1rem;">
          <% if (page > 1) { %><a href="/garage/admin/photos?q=<%= encodeURIComponent(q) %>&page=<%= page - 1 %>">← Previous</a><% } %>
          <span>Page <%= page %> of <%= totalPages %></span>
          <% if (page < totalPages) { %><a href="/garage/admin/photos?q=<%= encodeURIComponent(q) %>&page=<%= page + 1 %>">Next →</a><% } %>
        </nav>
      <% } %>
    </section>
  <% } %>

  <% if (selectedCar) { %>
    <section aria-labelledby="photo-selected-heading">
      <div class="photo-review-current mb-4">
        <img src="<%= cardPhoto(selectedCar.image) %>" alt="Current cover for <%= selectedCar.make %> <%= selectedCar.model %>">
        <div>
          <p class="eyebrow mb-2">Current cover</p>
          <h2 id="photo-selected-heading"><%= selectedCar.make %> <%= selectedCar.model %></h2>
          <a href="/cars/car?make=<%= encodeURIComponent(selectedCar.make) %>&model=<%= encodeURIComponent(selectedCar.model) %>">View vehicle →</a>
        </div>
      </div>
      <p>Check that the photo shows this vehicle and that its source terms suit this use before choosing a cover.</p>
      <div class="photo-review-links mb-4">
        <% const query = encodeURIComponent(selectedCar.make + ' ' + selectedCar.model); %>
        <a href="https://www.google.com/search?tbm=isch&q=<%= query %>" target="_blank" rel="noopener noreferrer">Search Google Images ↗</a>
        <a href="https://commons.wikimedia.org/w/index.php?title=Special:MediaSearch&type=image&search=<%= query %>" target="_blank" rel="noopener noreferrer">Search Commons ↗</a>
        <a href="https://openverse.org/search/image?q=<%= query %>" target="_blank" rel="noopener noreferrer">Search Openverse ↗</a>
      </div>
      <% errors.forEach(error => { %><div class="alert alert-warning" role="status"><%= error.message %></div><% }) %>
      <% if (!candidates.length) { %>
        <div class="empty-state"><h3>No suitable candidates found</h3><p>Try the source searches above. The current cover stays in place until a replacement is chosen.</p></div>
      <% } else { %>
        <div class="row">
          <% candidates.forEach(candidate => { %>
            <div class="col-md-6 col-lg-4 mb-4">
              <article class="card photo-candidate h-100">
                <a href="<%= candidate.sourceUrl %>" target="_blank" rel="noopener noreferrer"><img class="card-img-top" src="<%= candidate.previewUrl || candidate.url %>" alt="<%= candidate.title %>" loading="lazy"></a>
                <div class="card-body d-flex flex-column">
                  <p class="eyebrow"><%= candidate.provider === 'wikimedia' ? 'Wikimedia Commons' : 'Openverse' %></p>
                  <h3 class="h6"><%= candidate.title %></h3>
                  <p class="mb-2">Photo: <%= candidate.creditName %><br><a href="<%= candidate.licenseUrl %>" target="_blank" rel="noopener noreferrer license"><%= candidate.license %></a></p>
                  <a class="mb-3" href="<%= candidate.sourceUrl %>" target="_blank" rel="noopener noreferrer">View original source ↗</a>
                  <form class="mt-auto" method="POST" action="/garage/admin/photos/<%= selectedCar.id %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="provider" value="<%= candidate.provider %>">
                    <input type="hidden" name="candidateId" value="<%= candidate.id %>">
                    <button class="btn btn-primary btn-block" type="submit">Use as cover</button>
                  </form>
                </div>
              </article>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  <% } else if (!q) { %>
    <p>Search any catalog vehicle to find a replacement photo, including vehicles that already have a cover.</p>
  <% } %>
</div>
