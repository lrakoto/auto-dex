<style>
  body {
    background: url(https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1920&q=80) center center / cover no-repeat fixed;
  }
  .home-overlay {
    background: linear-gradient(to right, rgba(3,6,14,0.24) 40%, rgba(3,6,14,0.10) 100%);
    min-height: calc(100vh - 56px);
    display: flex;
    flex-direction: column;
  }
  .home-inner {
    flex: 1;
    display: flex;
    align-items: center;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 0 2rem;
  }
  #recently-viewed {
    padding: 1.25rem 2rem 1.75rem;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    align-self: stretch;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
</style>

<div class="home-overlay">
  <div class="home-inner">
    <div class="custom-wrap">
      <p class="eyebrow hero-sub" style="margin-bottom:1.25rem;">Vehicle Explorer</p>
      <h1 class="cover-heading">The Car<br>Database.</h1>
      <% if (cotd) { %>
        <%# Under the heading, not beside it: the hero photo's car stays in view %>
        <aside class="cotd hero-sub" style="animation-delay:0.5s;" aria-label="Car of the Day">
          <a class="cotd-card" href="/cars/car?make=<%= encodeURIComponent(cotd.make) %>&model=<%= encodeURIComponent(cotd.model) %>">
            <span class="cotd-photo"><img src="<%= cardPhoto(cotd.image) %>" alt="<%= cotd.make %> <%= cotd.model %>"></span>
            <span class="cotd-body">
              <span class="cotd-eyebrow">Car of the Day</span>
              <span class="cotd-name" title="<%= cotd.make %> <%= cotd.model %>"><span class="cotd-make"><%= cotd.make %></span> <span class="cotd-model"><%= cotd.model %></span></span>
              <% if (cotd.years || cotd.country) { %>
                <span class="cotd-meta"><%= [cotd.years, cotd.country].filter(Boolean).join(' · ') %></span>
              <% } %>
            </span>
            <span class="cotd-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <p class="cotd-foot">
            <% if (cotd.credit) { %><span class="cotd-credit"><%- include('partials/photo-credit', { credit: cotd.credit }) %></span><% } %>
            <a class="cotd-play" href="/play">Who's That Car? Name it from a photo &rarr;</a>
          </p>
        </aside>
      <% } %>
      <p class="lead mb-4 hero-sub" style="animation-delay:0.65s;">Browse thousands of makes and models. Search by manufacturer, discover specs, and build your personal garage.</p>

      <form action="/search" method="GET" class="d-flex align-items-end hero-form" style="gap:0.75rem;flex-wrap:wrap;">
        <div class="search-input-wrap" style="flex:1;min-width:220px;">
          <label for="q">Make or Model</label>
          <input type="text" class="form-control form-control-lg" name="q" id="q" placeholder="e.g. Toyota, Camry, Ferrari…" autocomplete="off">
          <div class="suggest-dropdown"></div>
        </div>
        <button class="btn btn-primary btn-lg" type="submit" style="padding:0.65rem 1.75rem;white-space:nowrap;">Search &rarr;</button>
      </form>
    </div>
  </div>

  <div id="recently-viewed" style="display:none;">
    <p class="eyebrow" style="margin-bottom:1rem;">Recently Viewed</p>
    <div class="row recently-viewed-row"></div>
  </div>
</div>
