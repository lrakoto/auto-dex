<style>
  body {
    background: url(https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1920&q=80) center center / cover no-repeat fixed;
  }
  .home-overlay {
    background: linear-gradient(to right, rgba(3,6,14,0.68) 40%, rgba(3,6,14,0.12) 100%);
    min-height: calc(100vh - 56px);
    display: flex;
    flex-direction: column;
  }
  .home-inner {
    flex: 1;
    display: flex;
    align-items: center;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .home-inner .custom-wrap {
    width: 100%;
    min-width: 0;
    max-width: 600px;
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  .home-inner .home-copy { color: #e2e8f0; }
  .home-search {
    /* Keep suggestions above the featured card's animation stacking context. */
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .home-search .search-input-wrap { flex: 1 1 220px; min-width: 0; }
  .home-search label { color: #cbd5e1; }
  .home-search .form-control { min-height: 48px; font-size: 1rem; background: rgba(10,16,28,0.94); }
  .home-search .form-control::placeholder { color: #9ca3af; opacity: 1; }
  .home-search button { min-height: 48px; padding: 0.65rem 1.75rem; white-space: nowrap; }
  .home-inner .cotd { margin-bottom: 0; }
  .home-inner .cotd-credit { min-width: 0; overflow-wrap: anywhere; }
  #recently-viewed {
    padding: 1.25rem 2rem 1.75rem;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    align-self: stretch;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  @media (max-width: 768px) {
    .home-inner { padding: 0 1.25rem; }
    .home-inner .custom-wrap { padding: 3rem 0; }
    #recently-viewed { padding-left: 1.25rem; padding-right: 1.25rem; }
    .home-inner .cotd-play { margin-left: 0; }
  }
  @media (max-width: 520px) {
    .home-search .search-input-wrap { flex-basis: 100%; }
    .home-search button { width: 100%; }
  }
</style>

<div class="home-overlay">
  <div class="home-inner">
    <div class="custom-wrap">
      <p class="eyebrow hero-sub" style="margin-bottom:1.25rem;">Vehicle Explorer</p>
      <h1 class="cover-heading">The Car<br>Database.</h1>
      <p class="lead mb-4 hero-sub home-copy" style="animation-delay:0.5s;">Search makes and models, compare specs, and build your garage.</p>

      <form action="/search" method="GET" class="hero-form home-search">
        <div class="search-input-wrap">
          <label for="q">Make or Model</label>
          <input type="text" class="form-control form-control-lg" name="q" id="q" placeholder="Toyota, Civic, Porsche…" autocomplete="off" enterkeyhint="search">
          <div class="suggest-dropdown"></div>
        </div>
        <button class="btn btn-primary btn-lg" type="submit">Search &rarr;</button>
      </form>
      <% if (cotd) { %>
        <%# Keep discovery below the primary search, clear of the hero photo %>
        <aside class="cotd hero-sub" style="animation-delay:0.75s;" aria-label="Car of the Day">
          <a class="cotd-card" href="/cars/car?make=<%= encodeURIComponent(cotd.make) %>&model=<%= encodeURIComponent(cotd.model) %>">
            <span class="cotd-photo"><img src="<%= cardPhoto(cotd.image) %>" alt="<%= cotd.make %> <%= cotd.model %>"></span>
            <span class="cotd-body">
              <span class="cotd-eyebrow">Car of the Day</span>
              <span class="cotd-name" title="<%= cotd.make %> <%= cotd.model %>"><span class="cotd-make"><%= cotd.make %></span> <span class="cotd-model"><%= cotd.model %></span></span>
              <% if (cotd.years || cotd.country) { %>
                <span class="cotd-meta"><%= [cotd.years, cotd.country].filter(Boolean).join(' · ') %></span>
              <% } %>
            </span>
            <span class="cotd-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <p class="cotd-foot">
            <% if (cotd.credit) { %><span class="cotd-credit"><%- include('partials/photo-credit', { credit: cotd.credit }) %></span><% } %>
            <a class="cotd-play" href="/play">Who's That Car? Name it from a photo &rarr;</a>
          </p>
        </aside>
      <% } %>
    </div>
  </div>

  <div id="recently-viewed" style="display:none;">
    <p class="eyebrow" style="margin-bottom:1rem;">Recently Viewed</p>
    <div class="row recently-viewed-row"></div>
  </div>
</div>
