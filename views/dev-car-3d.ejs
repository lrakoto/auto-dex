<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>3D Viewer Lab | AutoDex</title>
  <link rel="stylesheet" href="/css/car-3d-demo.css">
  <% if (assetsReady) { %><script src="/js/car-3d-demo.js" defer></script><% } %>
</head>
<body>
  <header class="lab-masthead">
    <% if (scene.homeHref) { %>
      <a href="<%= scene.homeHref %>" class="lab-brand">Auto<span>Dex</span></a>
    <% } else { %>
      <span class="lab-brand">Auto<span>Dex</span></span>
    <% } %>
    <span class="lab-tag">Local preview</span>
  </header>
  <main id="car-3d-demo" class="lab" aria-labelledby="lab-title">
    <div class="lab-intro">
      <p class="lab-kicker">AutoDex Lab / 01</p>
      <h1 id="lab-title">3D Viewer Lab</h1>
      <% if (assetsReady) { %><p><%= scene.intro %></p><% } %>
    </div>
    <section class="lab-card" aria-labelledby="lab-model">
      <div class="lab-toolbar">
        <div>
          <p class="lab-kicker"><%= scene.category %></p>
          <h2 id="lab-model"><%= scene.name %></h2>
        </div>
        <% if (assetsReady) { %>
          <div class="lab-actions">
            <button id="car-3d-load" type="button" aria-controls="car-3d-stage" hidden>Load 3D model</button>
            <p id="car-3d-status" role="status"></p>
          </div>
        <% } %>
      </div>
      <% if (posterReady) { %>
        <figure class="lab-figure">
          <div id="car-3d-stage" class="lab-stage"<% if (assetsReady) { %> data-state="idle" data-model-url="<%= modelUrl %>" data-model-alt="<%= scene.modelAlt %>"<% } %>>
            <img id="car-3d-poster" class="lab-poster" src="<%= posterUrl %>" alt="<%= scene.posterAlt %>">
          </div>
          <% if (assetsReady) { %>
            <div id="car-3d-controls" class="lab-camera-controls" role="group" aria-label="3D camera controls" hidden>
              <button id="car-3d-zoom-in" type="button" aria-controls="car-3d-stage">Zoom in</button>
              <button id="car-3d-zoom-out" type="button" aria-controls="car-3d-stage">Zoom out</button>
              <button id="car-3d-reset" type="button" aria-controls="car-3d-stage">Reset view</button>
            </div>
            <figcaption class="lab-caption">
              <p id="car-3d-instructions">Drag to orbit. On touch, swipe sideways to turn the car. With the viewer focused, use the arrow keys.</p>
              <noscript><p>Enable JavaScript to explore the 3D model.</p></noscript>
            </figcaption>
          <% } %>
        </figure>
      <% } %>
      <% if (!assetsReady) { %>
        <div class="lab-missing" id="car-3d-missing">
          <p>3D preview files are unavailable.</p>
          <p><%= scene.missingAssetHelp || 'Run the local 3D demo setup in the AutoDex checkout, then reload this page.' %></p>
        </div>
      <% } %>
      <div class="lab-credit">
        <p><% if (scene.creditUrl) { %><a href="<%= scene.creditUrl %>"><%= scene.creditLabel %></a><% } else { %><%= scene.creditLabel %><% } %><% if (scene.creditNote) { %> · <%= scene.creditNote %><% } %></p>
      </div>
    </section>
  </main>
</body>
</html>
