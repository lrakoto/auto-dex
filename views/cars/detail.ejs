<!-- Recently-viewed data is read by main.js (no inline script — CSP-safe).
     EJS HTML-escapes attribute values, so no </script>/quote break-out. -->
<div id="car-recent-data" hidden
     data-make="<%= make %>"
     data-model="<%= model %>"
     data-image="<%= image %>"></div>

<!-- Hero Image -->
<div class="car-hero" style="background-image: url('<%= image %>');">
  <div class="car-hero-overlay">
    <div class="car-hero-text">
      <h1><%= make %> <span><%= model %></span></h1>
      <% if (country || years) { %>
        <p class="car-hero-sub"><%= [country, years].filter(Boolean).join(' · ') %></p>
      <% } %>
    </div>
  </div>
</div>

<!-- Actions Bar -->
<div class="detail-container">
  <div class="detail-actions d-flex justify-content-between align-items-center flex-wrap" style="gap:1rem;">
    <a href="/cars?selectmake=<%= encodeURIComponent(make) %>" class="btn btn-outline-secondary btn-sm">&larr; <%= make %></a>
    <div class="d-flex align-items-center" style="gap:1rem;">
      <span id="detail-fav-count" style="font-size:0.8rem;color:var(--text-muted);">&#9825; <%= favcount %></span>
      <% if (currentUser) { %>
        <div id="detail-fav-area" class="d-flex align-items-center" style="gap:0.5rem;">
          <% if (userFavorite) { %>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-toggle="modal" data-target="#detailEditFavModal">Edit Favorite</button>
            <form class="detail-remove-form d-inline" style="margin:0;" data-fav-id="<%= userFavorite.id %>">
              <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
            </form>
          <% } else { %>
            <form action="/cars/fav" method="POST" class="detail-fav-form d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="favecar_model" value="<%= model %>"/>
              <input type="hidden" name="favecar_make" value="<%= make %>"/>
              <input type="hidden" name="favecar_image" value="<%= image %>"/>
              <input type="hidden" name="userId" value="<%= currentUser.id %>"/>
              <button type="submit" class="btn btn-primary btn-sm">+ Favorite</button>
            </form>
          <% } %>
        </div>
        <!-- Template for restoring + Favorite button after remove -->
        <template id="detail-fav-template">
          <form action="/cars/fav" method="POST" class="detail-fav-form d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="favecar_model" value="<%= model %>"/>
            <input type="hidden" name="favecar_make" value="<%= make %>"/>
            <input type="hidden" name="favecar_image" value="<%= image %>"/>
            <input type="hidden" name="userId" value="<%= currentUser.id %>"/>
            <button type="submit" class="btn btn-primary btn-sm">+ Favorite</button>
          </form>
        </template>
      <% } else { %>
        <a href="/auth/login" class="btn btn-primary btn-sm">Log in to Favorite</a>
      <% } %>
      <button type="button" class="btn btn-outline-secondary btn-sm compare-add-btn"
              data-make="<%= make %>" data-model="<%= model %>" data-image="<%= image %>">+ Compare</button>
      <% if (currentUser) { %>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-toggle="modal" data-target="#spotModal">
          👀 Spotted it<% if (mySpotCount > 0) { %> <span class="spot-count">×<%= mySpotCount %></span><% } %>
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-toggle="modal" data-target="#proposeImgModal"><%= carUpdatedImg ? 'Add Photo' : 'Propose Image' %></button>
      <% } else { %>
        <a href="/auth/login" class="btn btn-outline-secondary btn-sm">👀 Log in to Spot</a>
      <% } %>
    </div>
  </div>
</div>

<div class="detail-container py-5 detail-section">
  <div class="row">

    <!-- About -->
    <div class="col-lg-8 mb-5 mb-lg-0">
      <div class="accent-line"></div>
      <h2 class="mb-4" style="font-size:1.75rem;"><%= make %> <span style="font-weight:300;"><%= model %></span></h2>
      <% if (wikiSummary) { %>
        <p class="lead" style="color:#a1a1aa;line-height:1.75;"><%= wikiSummary %></p>
        <% if (wikiUrl) { %>
          <a href="<%= wikiUrl %>" target="_blank" rel="noopener" style="font-size:0.78rem;letter-spacing:0.06em;text-transform:uppercase;color:#52525b;">
            Wikipedia &rarr;
          </a>
        <% } %>
      <% } else { %>
        <p class="text-muted">No description available for this model.</p>
      <% } %>
      <% if (typeof carSpecs !== 'undefined' && carSpecs) { %>
        <div class="specs-grid" style="margin-top:2rem;">
          <div class="accent-line"></div>
          <h5 style="font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-subtle);margin:1rem 0 1rem;">Specs — <%= carSpecs.year %></h5>
          <div class="specs-row">
            <% if (carSpecs.type) { %><div class="spec-item"><span class="spec-label">Class</span><span class="spec-value"><%= carSpecs.type %></span></div><% } %>
            <% if (carSpecs.displacement) { %><div class="spec-item"><span class="spec-label">Engine</span><span class="spec-value"><%= carSpecs.displacement %>L<% if (carSpecs.cylinders) { %> &middot; <%= carSpecs.cylinders %>-cyl<% } %></span></div><% } %>
            <% if (carSpecs.transmission) { %><div class="spec-item"><span class="spec-label">Transmission</span><span class="spec-value"><%= carSpecs.transmission %></span></div><% } %>
            <% if (carSpecs.drive) { %><div class="spec-item"><span class="spec-label">Drive</span><span class="spec-value"><%= carSpecs.drive %></span></div><% } %>
            <% if (carSpecs.fuel) { %><div class="spec-item"><span class="spec-label">Fuel</span><span class="spec-value"><%= carSpecs.fuel %></span></div><% } %>
            <% if (carSpecs.cityMpg && carSpecs.hwyMpg) { %><div class="spec-item"><span class="spec-label">MPG</span><span class="spec-value"><%= carSpecs.cityMpg %> city &middot; <%= carSpecs.hwyMpg %> hwy</span></div><% } %>
          </div>
        </div>
      <% } %>
      <% if (wikiFacts && wikiFacts.length) { %>
        <div class="facts-panel">
          <div class="accent-line"></div>
          <h5 class="section-label">At a Glance</h5>
          <dl class="facts-list">
            <% wikiFacts.forEach(f => { %>
              <div class="fact-row">
                <dt><%= f.label %></dt>
                <dd>
                  <% f.values.forEach((v, i) => { %><% if (i) { %>, <% } %><% if (f.link) { %><a href="/search?q=<%= encodeURIComponent(v) %>"><%= v %></a><% } else { %><%= v %><% } %><% }) %>
                </dd>
              </div>
            <% }) %>
          </dl>
          <p class="facts-source">Source: <a href="https://www.wikidata.org/" target="_blank" rel="noopener">Wikidata</a> (CC0)</p>
        </div>
      <% } %>
    </div>

    <!-- Media Links -->
    <div class="col-lg-4">
      <div class="media-card">
        <h5>Watch &amp; Read</h5>
        <% mediaLinks.forEach(link => { %>
          <a href="<%= link.url %>" target="_blank" rel="noopener"
             class="d-flex align-items-center py-2"
             style="border-bottom:1px solid #27272a;color:#a1a1aa;font-size:0.85rem;gap:0.6rem;">
            <span><%= link.icon %></span>
            <span><%= link.label %></span>
            <span class="ml-auto" style="font-size:0.72rem;color:#3f3f46;">↗</span>
          </a>
        <% }) %>
      </div>
    </div>

  </div>

  <!-- Photo Gallery -->
  <% if (gallery.length > 0) { %>
    <div class="gallery-section" id="gallery">
      <p class="eyebrow" style="margin-bottom:0.5rem;">Photos</p>
      <p class="gallery-hint">Vote for the best shot of the <%= model %> — the top photo becomes the cover.</p>
      <div class="gallery-grid">
        <% gallery.forEach(img => { %>
          <figure class="gallery-item" data-image-id="<%= img.id %>">
            <button type="button" class="gallery-thumb" data-full="<%= img.url %>" aria-label="Preview this photo">
              <img src="<%= img.url %>" alt="<%= make %> <%= model %> photo" loading="lazy">
            </button>
            <figcaption class="gallery-meta">
              <% if (currentUser) { %>
                <form method="POST" action="/cars/images/<%= img.id %>/vote" class="vote-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="value" value="<%= img.myVote === 1 ? 0 : 1 %>">
                  <button type="submit" class="vote-btn vote-up<%= img.myVote === 1 ? ' active' : '' %>" aria-label="Upvote" aria-pressed="<%= img.myVote === 1 %>">▲</button>
                </form>
                <span class="vote-score"><%= img.score %></span>
                <form method="POST" action="/cars/images/<%= img.id %>/vote" class="vote-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="value" value="<%= img.myVote === -1 ? 0 : -1 %>">
                  <button type="submit" class="vote-btn vote-down<%= img.myVote === -1 ? ' active' : '' %>" aria-label="Downvote" aria-pressed="<%= img.myVote === -1 %>">▼</button>
                </form>
                <% if (currentUser.isAdmin) { %>
                  <form method="POST" action="/garage/admin/image/<%= img.id %>?_method=DELETE" class="ml-auto">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="vote-btn" aria-label="Remove photo" title="Remove photo (admin)">✕</button>
                  </form>
                <% } %>
              <% } else { %>
                <span class="vote-score"><%= img.score %> pts</span>
              <% } %>
              <span class="gallery-source"><%= img.source %></span>
            </figcaption>
          </figure>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- Related Models -->
  <% if (relatedCars.length > 0) { %>
    <div style="margin-top:4rem;">
      <p class="eyebrow" style="margin-bottom:1.25rem;">More from <%= make %></p>
      <div class="row related-row">
        <% relatedCars.forEach(c => { %>
          <div class="col-md-4 col-6 mb-4 card-col">
            <div class="card h-100">
              <a href="/cars/car?make=<%= encodeURIComponent(c.make) %>&model=<%= encodeURIComponent(c.model) %>">
                <img class="card-img-top imgresp" src="<%= c.image %>" alt="<%= c.model %>">
              </a>
              <div class="card-body">
                <p class="card-text mb-0">
                  <a href="/cars/car?make=<%= encodeURIComponent(c.make) %>&model=<%= encodeURIComponent(c.model) %>" class="text-dark card-cover"><%= c.model %></a>
                </p>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>

<% if (currentUser) { %>
<div class="modal fade" id="proposeImgModal" tabindex="-1" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= carUpdatedImg ? 'Add a Photo' : 'Propose an Image' %></h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      </div>
      <form method="POST" action="/cars/propose-image">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-body">
          <p style="font-size:0.82rem;color:var(--text-muted);">Suggest a photo of the <strong><%= make %> <%= model %></strong>. Once an admin approves it, it joins the gallery and the community votes on the cover shot.</p>
          <% if (carDbId) { %>
            <input type="hidden" name="carId" value="<%= carDbId %>">
          <% } else { %>
            <input type="hidden" name="make" value="<%= make %>">
            <input type="hidden" name="model" value="<%= model %>">
          <% } %>
          <input type="text" class="form-control" name="imageUrl" placeholder="https://…" autocomplete="off" required>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary btn-sm">Submit Proposal</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<% if (currentUser) { %>
<div class="modal fade" id="spotModal" tabindex="-1" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Spotted a <%= make %> <%= model %>?</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      </div>
      <form method="POST" action="/cars/spot?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="make" value="<%= make %>">
        <input type="hidden" name="model" value="<%= model %>">
        <div class="modal-body">
          <p style="font-size:0.82rem;color:var(--text-muted);">Log it in your Dex. Everything below is optional.</p>
          <label class="field-label" for="spotImage">Photo</label>
          <input type="file" class="form-control-file mb-2" id="spotImage" name="spotImage" accept="image/jpeg,image/png,image/webp">
          <input type="text" class="form-control mb-3" name="imageUrl" placeholder="…or paste a photo URL" autocomplete="off">
          <label class="field-label" for="spotLocation">Where</label>
          <input type="text" class="form-control mb-3" id="spotLocation" name="location" maxlength="120" placeholder="e.g. Cars &amp; Coffee, Malibu">
          <label class="field-label" for="spotNotes">Notes</label>
          <textarea class="form-control" id="spotNotes" name="notes" rows="2" maxlength="1000" placeholder="Color, mods, anything memorable"></textarea>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary btn-sm">Add to my Dex</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<% if (currentUser && userFavorite) { %>
<div class="modal fade" id="detailEditFavModal" tabindex="-1" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= make %> <%= model %></h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="img-source-tabs" role="tablist" aria-label="Image source">
          <button type="button" role="tab" id="detail-fav-url-tab" class="img-tab-btn active" data-tab="detail-fav-url" aria-controls="detail-fav-url" aria-selected="true">Use URL</button>
          <button type="button" role="tab" id="detail-fav-upload-tab" class="img-tab-btn" data-tab="detail-fav-upload" aria-controls="detail-fav-upload" aria-selected="false" tabindex="-1">Upload File</button>
        </div>
        <div id="detail-fav-url" class="img-tab-pane" role="tabpanel" aria-labelledby="detail-fav-url-tab">
          <form id="detail-fav-url-form" method="POST" action="/cars/favorites/edit/<%= userFavorite.id %>?_method=PUT">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="favid" value="<%= userFavorite.id %>">
            <input type="text" class="form-control" name="newimagelink" placeholder="https://…" autocomplete="off">
          </form>
        </div>
        <div id="detail-fav-upload" class="img-tab-pane" role="tabpanel" aria-labelledby="detail-fav-upload-tab" style="display:none;">
          <form id="detail-fav-upload-form" method="POST" action="/cars/favorites/edit/<%= userFavorite.id %>?_method=PUT&_csrf=<%= csrfToken %>" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="favid" value="<%= userFavorite.id %>">
            <input type="file" class="form-control-file" name="newimage" accept="image/*">
          </form>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary detail-fav-save">Update Image</button>
      </div>
    </div>
  </div>
</div>
<% } %>
