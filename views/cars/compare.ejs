<section class="jumbotron text-center">
  <div class="container">
    <h1 class="jumbotron-heading" id="compare-heading">Compare</h1>
    <p class="lead text-muted">Up to three cars, side by side. Add cars with <strong>+ Compare</strong> on any car page.</p>
  </div>
</section>

<div class="container pb-5">
  <% if (cars.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">⇄</div>
      <h3>Nothing to compare yet</h3>
      <p>Open a car and hit <strong>+ Compare</strong>, then come back here.</p>
      <a href="/makes" class="btn btn-outline-secondary mt-3">Browse Manufacturers</a>
    </div>
  <% } else { %>
    <%
      // Rows: label + a per-car value getter. Rows where no car has a value are skipped.
      var specRows = [
        ['Years', c => c.years],
        ['Favorites', c => c.favcount ? '♥ ' + c.favcount : null],
        ['Class', c => c.specs && c.specs.type],
        ['Engine', c => c.specs && c.specs.displacement ? c.specs.displacement + 'L' + (c.specs.cylinders ? ' · ' + c.specs.cylinders + '-cyl' : '') : null],
        ['Transmission', c => c.specs && c.specs.transmission],
        ['Drive', c => c.specs && c.specs.drive],
        ['Fuel', c => c.specs && c.specs.fuel],
        ['MPG (city / hwy)', c => c.specs && c.specs.cityMpg ? c.specs.cityMpg + ' / ' + c.specs.hwyMpg : null],
        ['Annual Fuel Cost', c => c.specs && c.specs.annualFuelCost != null ? '$' + c.specs.annualFuelCost.toLocaleString('en-US') : null],
        ['5-Yr vs Avg New Vehicle', c => c.specs && c.specs.fiveYearSavings != null ? (c.specs.fiveYearSavings === 0 ? 'Same as average' : c.specs.fiveYearSavings > 0 ? 'Save $' + c.specs.fiveYearSavings.toLocaleString('en-US') : 'Spend $' + Math.abs(c.specs.fiveYearSavings).toLocaleString('en-US')) : null],
        ['Tailpipe CO₂', c => c.specs && c.specs.co2 != null ? c.specs.co2 + ' g/mi' : null],
        ['EPA Fuel Economy Score', c => c.specs && c.specs.feScore != null ? c.specs.feScore + '/10' : null],
        ['EPA GHG Score', c => c.specs && c.specs.ghgScore != null ? c.specs.ghgScore + '/10' : null],
        ['Specs year', c => c.specs && c.specs.year],
        ['NHTSA Overall', c => c.ratings && c.ratings.overall ? '★'.repeat(c.ratings.overall) + '☆'.repeat(5 - c.ratings.overall) : null],
        ['NHTSA Frontal', c => c.ratings && c.ratings.frontal ? '★'.repeat(c.ratings.frontal) + '☆'.repeat(5 - c.ratings.frontal) : null],
        ['NHTSA Side', c => c.ratings && c.ratings.side ? '★'.repeat(c.ratings.side) + '☆'.repeat(5 - c.ratings.side) : null],
        ['NHTSA Rollover', c => c.ratings && c.ratings.rollover ? '★'.repeat(c.ratings.rollover) + '☆'.repeat(5 - c.ratings.rollover) : null],
        ['Safety rating year', c => c.ratings && c.ratings.year ? c.ratings.year + (c.ratings.ratedAs ? ' (' + c.ratings.ratedAs + ')' : '') : null]
      ];
      factLabels.forEach(label => specRows.push([label, c => c.facts[label]]));
    %>
    <% if (cars.length > 1) { %>
      <p class="compare-scroll-hint"><span aria-hidden="true">↔</span> Swipe or scroll sideways to see every vehicle.</p>
    <% } %>
    <p class="sr-only" id="compare-keyboard-help">Use the Left and Right arrow keys to scroll the comparison when it is focused.</p>
    <div class="compare-wrap" tabindex="0" role="region" aria-labelledby="compare-heading" aria-describedby="compare-keyboard-help">
      <table class="compare-table<%= cars.length === 1 ? ' compare-table--single' : '' %>">
        <caption class="sr-only">Specifications for <%= cars.map(c => c.make + ' ' + c.model).join(', ') %></caption>
        <thead>
          <tr>
            <th scope="col" class="compare-spec-heading">Spec</th>
            <% cars.forEach(c => { %>
              <th scope="col">
                <a href="/cars/car?make=<%= encodeURIComponent(c.make) %>&model=<%= encodeURIComponent(c.model) %>" class="compare-car">
                  <img src="<%= cardPhoto(c.image) %>" alt="<%= c.make %> <%= c.model %>">
                  <span class="compare-make"><%= c.make %></span>
                  <span class="compare-model"><%= c.model %></span>
                </a>
                <button type="button" class="compare-remove-btn" data-make="<%= c.make %>" data-model="<%= c.model %>" aria-label="Remove <%= c.make %> <%= c.model %> from comparison">Remove</button>
              </th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% specRows.forEach(([label, get]) => {
               var vals = cars.map(get);
               if (!vals.some(Boolean)) return; %>
            <tr>
              <th scope="row"><%= label %></th>
              <% vals.forEach(v => { %><td><%= v || '—' %></td><% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="facts-source mt-3">Specs: FuelEconomy.gov · Facts: Wikidata · Years &amp; Safety: NHTSA</p>
    <%- include('../partials/fuel-estimate-note', { specs: cars.map(c => c.specs) }) %>
    <% if (size) { %><%- include('../partials/size-compare', { size, formatDims }) %><% } %>
  <% } %>
</div>
