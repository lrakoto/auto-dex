# Default: auto-detect text vs binary, normalize line endings in repo
* text=auto

# Source code — LF in repo (normalized on checkout per OS)
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.ejs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.svg   text eol=lf
*.md    text eol=lf

# Shell scripts & Linux server config — MUST be LF (run on Linux server)
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
Procfile    text eol=lf
.env.example text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Binary assets — never normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff  binary
*.woff2 binary